{% comment %}
  FAQ Section
  Accordion of question/answer blocks with FAQPage structured data
  for rich results and AI/GEO readiness.
{% endcomment %}

{%- style -%}
  #FAQ-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #FAQ-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="FAQ-{{ section.id }}" class="faq-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width faq-section__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="faq-section__list">
      {%- for block in section.blocks -%}
        <details class="faq-section__item" {{ block.shopify_attributes }}{% if block.settings.open_by_default %} open{% endif %}>
          <summary class="faq-section__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-section__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-section__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq-section__container {
    max-width: 80rem;
    margin: 0 auto;
  }

  .faq-section__heading {
    text-align: center;
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-text-heading, var(--color-text-primary, #111));
    margin: 0 0 24px;
  }

  .faq-section__item {
    border-bottom: 1px solid var(--color-border, #e0e0e0);
  }

  .faq-section__item:first-of-type {
    border-top: 1px solid var(--color-border, #e0e0e0);
  }

  .faq-section__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-primary, #111);
  }

  .faq-section__question::-webkit-details-marker {
    display: none;
  }

  .faq-section__question:hover {
    color: var(--color-primary, #0066c0);
  }

  .faq-section__icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .faq-section__icon::before,
  .faq-section__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease;
  }

  .faq-section__icon::after {
    transform: rotate(90deg);
  }

  .faq-section__item[open] .faq-section__icon::after {
    transform: rotate(0deg);
  }

  .faq-section__answer {
    padding: 0 4px 18px;
    color: var(--color-text-secondary, #444);
    line-height: 1.6;
  }

  .faq-section__answer p {
    margin: 0 0 10px;
  }

  .faq-section__answer p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you offer wholesale pricing?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes — contact us to learn more about trade accounts and bulk pricing.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
