                      <span class="product-card__stars">★★★★☆</span>
                      <span class="product-card__reviews">{{ block.settings.review_count }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% comment %} Column 3 {% endcomment %}
      {% if section.blocks.size > 0 %}
      <div class="product-grid__column {% unless section.settings.show_column3_mobile %}product-grid__column--mobile-hidden{% endunless %}">
        <div class="product-grid__header">
