      "label": "Promotional message link",
      "info": "When set, clicking the promotional message will navigate to this URL"
    },
    {
      "type": "text",
      "id": "promo_message",
      "label": "Promotional message",
      "default": "Special offer! Free shipping on orders over $45. Shop Now >"
    },
    {
      "type": "color",
      "id": "promo_bar_color",
      "label": "Promotional bar background",
      "default": "#005496"
    },
    {
      "type": "color",
      "id": "promo_bar_text_color",
      "label": "Promotional bar text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "header_element_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing between header elements",
      "default": 20,
      "info": "Control the spacing between logo, store hours, search bar, and sign in/cart buttons"
    },
    {
      "type": "range",
      "id": "header_padding_vertical",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Header vertical padding (top/bottom)",
      "default": 15,
      "info": "Control the top and bottom padding inside the header"
    },
    {
      "type": "range",
      "id": "header_padding_horizontal",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Header horizontal padding (left/right)",
      "default": 20,
      "info": "Control the left and right padding inside the header"
    },
    {
      "type": "header",
      "content": "Store Information"
