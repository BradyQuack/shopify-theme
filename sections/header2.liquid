      "info": "When enabled, the header will span the full width of the screen instead of being contained to 1200px"
    },
    {
      "type": "header",
      "content": "Promotional Bar"
    },
    {
      "type": "checkbox",
      "id": "show_promo_bar",
      "label": "Show promotional bar",
      "default": true
    },
    {
      "type": "url",
