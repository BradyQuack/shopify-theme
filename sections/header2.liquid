{{ 'section-header2.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Settings-driven values only; static rules live in assets/section-header2.css */
  .header2-section {
    --header2-promo-bg: {{ section.settings.promo_bar_color }};
    --header2-promo-text: {{ section.settings.promo_bar_text_color }};
    --header2-header-bg: {{ section.settings.header_bg_color }};
    --header2-nav-bg: {{ section.settings.nav_bg_color }};
    --header2-nav-hover: {{ section.settings.nav_hover_color }};
    --header2-nav-text-hover: {{ section.settings.nav_text_hover_color | default: '#333' }};
    --header2-shop-all-bg: {{ section.settings.shop_all_bg_color }};
    --header2-shop-all-text: {{ section.settings.shop_all_text_color }};
    --header2-shop-all-hover: {{ section.settings.shop_all_hover_color }};
    --header2-search-border: {{ section.settings.search_border_color }};
    --header2-search-btn: {{ section.settings.search_button_color }};
    --header2-search-btn-hover: {{ section.settings.search_button_hover_color }};
    --header2-accent: {{ section.settings.accent_color }};
    --header2-recommendation-hover: {{ section.settings.recommendation_hover_color | default: '#f0f8ff' }};
    --header2-max-width: {% if section.settings.header_full_width %}100%{% else %}1200px{% endif %};
    --header2-main-padding: {{ section.settings.header_padding_vertical | default: 15 }}px {{ section.settings.header_padding_horizontal | default: 20 }}px;
    --header2-main-gap: {{ section.settings.header_element_spacing | default: 20 }}px;
    --header2-logo-height: {{ section.settings.logo_height }}px;
    --header2-mobile-logo-height: {{ section.settings.mobile_logo_height }}px;
    --header2-search-max-width: {% if section.settings.search_no_max_width %}none{% else %}{{ section.settings.search_max_width | default: 600 }}px{% endif %};
    --header2-nav-max-width: {% if section.settings.nav_full_width %}100%{% else %}1200px{% endif %};
    {%- if section.settings.nav_full_width %}
    --header2-nav-justify: normal;
    --header2-nav-menu-justify: space-between;
    --header2-nav-menu-width: 100%;
    --header2-nav-item-flex: 1;
    --header2-nav-link-justify: center;
    {%- else %}
    --header2-nav-justify: center;
    --header2-nav-menu-justify: normal;
    --header2-nav-menu-width: auto;
    --header2-nav-item-flex: 0 1 auto;
    --header2-nav-link-justify: normal;
    {%- endif %}
    --header2-signin-icon-size: {{ section.settings.signin_icon_size | default: 28 }}px;
    --header2-cart-icon-size: {{ section.settings.cart_icon_size | default: 28 }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }
{%- endstyle -%}

<div class="header2-section">
  <!-- Top Promotional Bar -->
  {%- if section.settings.show_promo_bar -%}
    <div class="promo-bar">
      <div class="promo-bar__content">
        <div class="promo-bar__message">
          {%- if section.settings.promo_link != blank -%}
            <a href="{{ section.settings.promo_link }}" class="promo-bar__message-link">
              {{ section.settings.promo_message | default: "Special offer! Free shipping on orders over $45. Shop Now >" }}
            </a>
          {%- else -%}
            {{ section.settings.promo_message | default: "Special offer! Free shipping on orders over $45. Shop Now >" }}
          {%- endif -%}
        </div>
        <div class="promo-bar__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'promo_link' -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <!-- Mobile Menu Overlay -->
  <div class="header2__mobile-overlay" id="mobile-overlay">
    <div class="header2__mobile-menu" id="mobile-menu">
      <div class="header2__mobile-menu-header">
        <h3>Menu</h3>
        <button class="header2__mobile-close" id="mobile-close" aria-label="Close menu">&times;</button>
      </div>
      <ul class="header2__mobile-nav-list">
        <!-- Shop All -->
        <li class="header2__mobile-nav-item">
          <a href="{{ section.settings.shop_all_link | default: '/collections' }}" class="header2__mobile-nav-link header2__mobile-nav-link--shop-all">
            {{ section.settings.shop_all_text | default: 'Shop All' }}
          </a>
        </li>
        <!-- All Products -->
        {%- if section.settings.show_all_products_link -%}
          <li class="header2__mobile-nav-item">
            <a href="{{ section.settings.all_products_link | default: '/collections/all' }}" class="header2__mobile-nav-link">
              {{ section.settings.all_products_text | default: 'All Products' }}
            </a>
          </li>
        {%- endif -%}
        <!-- Navigation Links -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_item' -%}
            <li class="header2__mobile-nav-item">
              <a href="{{ block.settings.link }}" class="header2__mobile-nav-link">
                {{ block.settings.text }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <!-- Main Header -->
  <div class="header2">
    <div class="header2__main">
      <!-- Mobile Menu Button -->
      <button class="header2__mobile-menu-button" id="mobile-menu-button" aria-label="Open menu">
        <svg class="header2__mobile-menu-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
      </button>

      <!-- Logo -->
      <div class="header2__logo">
        <a href="{{ routes.root_url }}">
          {%- if settings.logo -%}
            {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
          {%- else -%}
            <h1>{{ shop.name }}</h1>
          {%- endif -%}
        </a>
      </div>

      <!-- Store Info -->
      <div class="header2__store-info">
        <div class="header2__store-icon">
          <svg class="header2__action-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
        </div>
        <div class="header2__store-details">
          <div class="header2__store-name">
            {{ section.settings.store_name | default: "Your Store" }}
          </div>
          <div class="header2__store-hours">
            {{ section.settings.store_hours | default: "10 PM" }}
          </div>
        </div>
      </div>

      <!-- Search -->
      <div class="header2__search">
        <form class="header2__search-form" action="{{ routes.search_url }}" method="get">
          <input
            class="header2__search-input"
            type="search"
            name="q"
            id="header-search-input"
            placeholder="{{ section.settings.search_placeholder | default: 'What can we help you find?' }}"
            value="{{ search.terms | escape }}"
            autocomplete="off"
            aria-label="{{ section.settings.search_placeholder | default: 'Search products' }}"
          >
          <button class="header2__search-button" type="submit" aria-label="Search">
            <svg width="20" height="20" fill="white" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </button>
        </form>
        <!-- Predictive Search Results -->
        <div class="header2__search-results" id="header-search-results"></div>
      </div>

      <!-- Actions -->
      <div class="header2__actions">
        <!-- Account -->
        <a href="{{ routes.account_url }}" class="header2__action">
          <span class="header2__signin-wrapper">
            <span class="header2__signin-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ section.settings.signin_icon_size | default: 28 }}" height="{{ section.settings.signin_icon_size | default: 28 }}" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </span>
          </span>
          {%- if customer -%}
            Account
          {%- else -%}
            Sign In
          {%- endif -%}
        </a>

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="header2__action" style="position: relative;">
          <span class="header2__cart-wrapper">
            <span class="header2__cart-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ section.settings.cart_icon_size | default: 28 }}" height="{{ section.settings.cart_icon_size | default: 28 }}" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/>
              </svg>
            </span>
          </span>
          Cart
          {%- if cart.item_count > 0 -%}
            <span class="header2__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ cart.item_count }} items in cart</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  <!-- Navigation Menu (Desktop Only) -->
  <div class="header2__nav">
    <div class="header2__nav-content">
      <ul class="header2__nav-menu">
        <!-- Shop All -->
        <li class="header2__nav-item">
          <a href="{{ section.settings.shop_all_link | default: '/collections' }}" class="header2__nav-link header2__nav-link--shop-all">
            <svg class="header2__nav-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z"/>
            </svg>
            {{ section.settings.shop_all_text | default: 'Shop All' }}
          </a>
          <!-- Dropdown Menu -->
          {%- if section.settings.show_shop_all_dropdown -%}
            <div class="header2__dropdown">
              <ul class="header2__dropdown-list">
                <li class="header2__dropdown-item">
                  <a href="{{ section.settings.all_products_link | default: '/collections/all' }}" class="header2__dropdown-link">
                    All Products
                  </a>
                </li>
                <div class="header2__dropdown-divider"></div>
                {%- for collection in collections -%}
                  {%- unless collection.handle == 'frontpage' -%}
                    <li class="header2__dropdown-item">
                      <a href="{{ collection.url }}" class="header2__dropdown-link">
                        {{ collection.title | escape }}
                      </a>
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </li>

        <!-- All Products -->
        {%- if section.settings.show_all_products_link -%}
          <li class="header2__nav-item">
            <a href="{{ section.settings.all_products_link | default: '/collections/all' }}" class="header2__nav-link">
              {{ section.settings.all_products_text | default: 'All Products' }}
            </a>
          </li>
        {%- endif -%}

        <!-- Navigation Links -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_item' -%}
            {%- if block.settings.show_in_navbar -%}
              <li class="header2__nav-item">
                <a href="{{ block.settings.link }}" class="header2__nav-link">
                  {%- if block.settings.show_icon -%}
                    <svg class="header2__nav-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {%- endif -%}
                  {{ block.settings.text }}
                </a>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <!-- Recommended Searches -->
  {%- if section.settings.show_recommendations -%}
    <div class="header2__recommendations">
      <div class="header2__recommendations-content">
        <span class="header2__recommendations-title">
          {{ section.settings.recommendations_title | default: 'Recommended Searches for You' }}
        </span>
        <div class="header2__recommendations-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'recommendation' -%}
              <a href="{{ block.settings.link }}" class="header2__recommendation-item">
                {{ block.settings.text }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.more_suggestions_text != blank -%}
          <a href="{{ section.settings.more_suggestions_link }}" class="header2__more-suggestions">
            {{ section.settings.more_suggestions_text | default: 'More Suggestions for You >' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile Menu Functionality
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileClose = document.getElementById('mobile-close');

    function openMobileMenu() {
      mobileOverlay.classList.add('active');
      mobileMenu.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileOverlay.classList.remove('active');
      mobileMenu.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (mobileMenuButton) {
      mobileMenuButton.addEventListener('click', openMobileMenu);
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', closeMobileMenu);
    }

    if (mobileOverlay) {
      mobileOverlay.addEventListener('click', function(e) {
        if (e.target === mobileOverlay) {
          closeMobileMenu();
        }
      });
    }

    // Close mobile menu on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileOverlay.classList.contains('active')) {
        closeMobileMenu();
      }
    });

    // Handle window resize
    window.addEventListener('resize', function() {
      if (window.innerWidth > 768 && mobileOverlay.classList.contains('active')) {
        closeMobileMenu();
      }
    });

    // Predictive Search Functionality
    const searchInput = document.getElementById('header-search-input');
    const searchResults = document.getElementById('header-search-results');
    let searchTimeout;

    function displaySearchResults(products) {
      if (products.length === 0) {
        searchResults.innerHTML = '<div class="header2__search-no-results">No products found</div>';
        return;
      }

      searchResults.innerHTML = products.map(product => {
        return `
          <a href="${product.url}" class="header2__search-item">
            <img src="${product.image}" alt="${product.title}" class="header2__search-item-image" />
            <div class="header2__search-item-info">
              <div class="header2__search-item-title">${product.title}</div>
            </div>
          </a>
        `;
      }).join('');
    }

    function performSearch(query) {
      if (!query || query.length < 2) {
        searchResults.classList.remove('active');
        return;
      }

      searchResults.innerHTML = '<div class="header2__search-loading">Searching...</div>';
      searchResults.classList.add('active');

      fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=8`)
        .then(response => response.json())
        .then(data => {
          const products = data.resources.results.products || [];
          displaySearchResults(products);
        })
        .catch(error => {
          console.error('Search error:', error);
          searchResults.innerHTML = '<div class="header2__search-no-results">Search error. Please try again.</div>';
        });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          performSearch(e.target.value);
        }, 300);
      });

      searchInput.addEventListener('focus', function(e) {
        if (e.target.value.length >= 2) {
          performSearch(e.target.value);
        }
      });

      // Close results when clicking outside
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.header2__search')) {
          searchResults.classList.remove('active');
        }
      });

      // Close results on escape key
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          searchResults.classList.remove('active');
        }
      });
    }

  });
</script>

{% schema %}
{
  "name": "Header2",
  "class": "header2-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "header_full_width",
      "label": "Use full width for header",
